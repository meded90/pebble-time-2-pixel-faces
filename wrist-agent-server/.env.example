PORT=8787
PUBLIC_BASE_URL=https://agent.example.com
DATA_DIR=./data

# Cloud Functions Gen 2 uses Firestore instead of DATA_DIR. The deployment
# script creates TTL policies for ${FIRESTORE_COLLECTION_PREFIX}_requests and
# ${FIRESTORE_COLLECTION_PREFIX}_idempotency.
FIRESTORE_COLLECTION_PREFIX=wrist_agent

# Generate with: openssl rand -base64 32
WRIST_AGENT_DEVICE_TOKENS=replace-with-a-random-device-token
CALLBACK_CAPABILITY_PEPPER=replace-with-an-independent-random-pepper

# Published Workspace Agent API channel and Workspace Agent access token.
WORKSPACE_AGENT_TRIGGER_ID=agtch_replace_me
WORKSPACE_AGENT_ACCESS_TOKEN=replace-with-workspace-agent-access-token

REQUEST_TTL_SECONDS=900
RETENTION_SECONDS=86400
WORKSPACE_AGENT_TIMEOUT_MS=15000
WORKSPACE_AGENT_MAX_ATTEMPTS=3
RATE_LIMIT_PER_MINUTE=20
MCP_RATE_LIMIT_PER_MINUTE=120
