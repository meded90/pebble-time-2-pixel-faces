{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pebble-time-2-pixel-faces/projects.schema.json",
  "title": "Pebble project catalog",
  "type": "object",
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": {"const": 1},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "buildGroup", "directory", "sourceVersion", "platforms", "preview", "description", "store", "artifact"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["watchface", "watchapp"]},
          "buildGroup": {"enum": ["faces", "standard-apps", "patched-apps"]},
          "directory": {"type": "string", "minLength": 1},
          "sourceVersion": {"type": "string", "minLength": 1},
          "platforms": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "preview": {"type": "string", "minLength": 1},
          "description": {
            "type": "object",
            "required": ["en", "ru"],
            "properties": {"en": {"type": "string"}, "ru": {"type": "string"}},
            "additionalProperties": false
          },
          "store": {
            "type": "object",
            "required": ["status"],
            "properties": {
              "status": {"enum": ["published", "candidate", "experimental"]},
              "publishedVersion": {"type": "string"},
              "url": {"type": "string", "format": "uri"}
            },
            "additionalProperties": false
          },
          "artifact": {
            "type": "object",
            "required": ["status", "version", "path"],
            "properties": {
              "status": {"enum": ["published", "candidate", "experimental"]},
              "version": {"type": "string"},
              "path": {"type": "string"},
              "note": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
