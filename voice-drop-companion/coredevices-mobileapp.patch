+package io.rebble.libpebblecommon.packets
+
+import io.rebble.libpebblecommon.protocolhelpers.PacketRegistry
+import io.rebble.libpebblecommon.protocolhelpers.PebblePacket
+import io.rebble.libpebblecommon.protocolhelpers.ProtocolEndpoint
+import io.rebble.libpebblecommon.structmapper.SBytes
+
+class VoiceDropPacket(bytes: UByteArray = ubyteArrayOf()) :
+    PebblePacket(ProtocolEndpoint.VOICE_DROP) {
+    val bytes = SBytes(
+        mapper = m,
+        default = bytes,
+        allRemainingBytes = bytes.isEmpty(),
+    )
+}
+
+fun voiceDropPacketsRegister() {
+    PacketRegistry.register(ProtocolEndpoint.VOICE_DROP) { VoiceDropPacket() }
+}
