--- /dev/null
+++ b/src/fw/applib/voice/voice_drop.h
@@ -0,0 +1,43 @@
+/* SPDX-FileCopyrightText: 2026 Voice Drop contributors */
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+//! State of the offline Voice Drop recorder.
+typedef enum {
+  VoiceDropStateIdle = 0,
+  VoiceDropStateRecording = 1,
+  VoiceDropStateStopping = 2,
+  VoiceDropStateSyncing = 3,
+  VoiceDropStateError = 4,
+} VoiceDropState;
+
+//! Result returned by Voice Drop control calls.
+typedef enum {
+  VoiceDropResultSuccess = 0,
+  VoiceDropResultBusy = 1,
+  VoiceDropResultNoSpace = 2,
+  VoiceDropResultUnavailable = 3,
+  VoiceDropResultInternalError = 4,
+} VoiceDropResult;
+
+//! Snapshot of recorder and queue state.
+typedef struct {
+  VoiceDropState state;
+  uint32_t elapsed_seconds;
+  uint32_t queued_bytes;
+  uint16_t queued_recordings;
+  int16_t last_error;
+} VoiceDropStatus;
+
+//! Start an offline recording using the watch microphone.
+VoiceDropResult voice_drop_start(void);
+
+//! Stop and finalize the current offline recording.
+VoiceDropResult voice_drop_stop(void);
+
+//! Copy the current recorder and queue status into @p status.
+bool voice_drop_get_status(VoiceDropStatus *status);
