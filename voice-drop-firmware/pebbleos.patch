+++ b/include/pbl/services/voice/voice_drop.h
@@ -0,0 +1,108 @@
+/* SPDX-FileCopyrightText: 2026 Voice Drop contributors */
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "applib/voice/voice_drop.h"
+#include "pbl/services/comm_session/session.h"
+
+#define VOICE_DROP_PROTOCOL_ENDPOINT 10001
+#define VOICE_DROP_SYNC_INTERVAL_MS (30U * 60U * 1000U)
+#define VOICE_DROP_STORAGE_LIMIT_BYTES (8U * 1024U * 1024U)
+
+typedef enum {
+  VoiceDropCommandList = 1,
+  VoiceDropCommandFetchChunk = 2,
+  VoiceDropCommandDataAck = 3,
+  VoiceDropCommandRecordingAck = 4,
+} VoiceDropCommand;
+
+typedef enum {
+  VoiceDropMessageQueueStatus = 0x81,
+  VoiceDropMessageRecordingMeta = 0x82,
+  VoiceDropMessageChunkData = 0x83,
+  VoiceDropMessageChunkDone = 0x84,
+  VoiceDropMessageRecordingDone = 0x85,
+  VoiceDropMessageError = 0xff,
+} VoiceDropMessage;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t command;
+  uint32_t after_recording_id;
+} VoiceDropListRequest;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t command;
+  uint32_t recording_id;
+  uint16_t chunk_index;
+  uint32_t offset;
+} VoiceDropFetchRequest;
+
+typedef VoiceDropFetchRequest VoiceDropDataAck;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t command;
+  uint32_t recording_id;
+} VoiceDropRecordingAck;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  uint16_t recording_count;
+  uint32_t total_bytes;
+} VoiceDropQueueStatusMessage;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  uint32_t recording_id;
+  uint32_t started_at;
+  uint32_t duration_ms;
+  uint32_t frame_count;
+  uint32_t payload_bytes;
+  uint32_t payload_crc32;
+  uint16_t chunk_count;
+  uint16_t sample_rate;
+  uint16_t bit_rate;
+  uint16_t frame_size;
+  uint8_t channels;
+  uint8_t speex_bitstream_version;
+} VoiceDropRecordingMetaMessage;
+
+#define VOICE_DROP_CHUNK_DATA_MAX 220
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  uint32_t recording_id;
+  uint16_t chunk_index;
+  uint32_t offset;
+  uint32_t chunk_size;
+  uint8_t data_size;
+  uint8_t data[VOICE_DROP_CHUNK_DATA_MAX];
+} VoiceDropChunkDataMessage;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  uint32_t recording_id;
+  uint16_t chunk_index;
+  uint32_t chunk_size;
+} VoiceDropChunkDoneMessage;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  uint32_t recording_id;
+} VoiceDropRecordingDoneMessage;
+
+typedef struct __attribute__((__packed__)) {
+  uint8_t message;
+  int16_t error;
+  uint32_t recording_id;
+} VoiceDropErrorMessage;
+
+void voice_drop_init(void);
+void voice_drop_protocol_msg_callback(CommSession *session, const uint8_t *data, size_t size);
+
+VoiceDropResult sys_voice_drop_start(void);
+VoiceDropResult sys_voice_drop_stop(void);
+bool sys_voice_drop_get_status(VoiceDropStatus *status);
