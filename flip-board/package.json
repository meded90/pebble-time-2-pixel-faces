{
  "name": "flip-board",
  "author": "Kirill Baldin",
  "version": "1.2.1",
  "keywords": [
    "pebble-app",
    "watchface",
    "flip-clock",
    "pixel",
    "emery"
  ],
  "private": true,
  "dependencies": {
    "@rebble/clay": "^1.0.10"
  },
